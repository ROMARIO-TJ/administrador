// Prisma Schema para AcademiaPro - Unión Jaguera FC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuario único Administrador
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuración general de la Academia
model AcademySetting {
  id                   Int      @id @default(autoincrement())
  // Información Institucional
  academyName          String   @default("Unión Jaguera FC")
  shortName            String   @default("UJFC")
  logo                 String?
  favicon              String?
  address              String   @default("La Jagua de Ibirico, Cesar, Colombia")
  city                 String   @default("La Jagua de Ibirico")
  department           String   @default("Cesar")
  country              String   @default("Colombia")
  phone                String   @default("+57 300 000 0000")
  whatsapp             String   @default("+57 300 000 0000")
  email                String   @default("contacto@unionjaguerafc.com")
  website              String   @default("https://unionjaguerafc.com")
  nit                  String   @default("900.000.000-1")
  representative       String   @default("Junta Directiva Unión Jaguera FC")
  description          String?

  // Configuración Financiera
  registrationFee      Float    @default(50000.0)
  monthlyFee           Float    @default(50000.0)
  dueDay               Int      @default(10)
  currency             String   @default("COP")
  currencySymbol       String   @default("$")
  allowDiscounts       Boolean  @default(true)
  allowPartialPayments Boolean  @default(true)

  // Apariencia
  primaryColor         String   @default("#2563EB")
  secondaryColor       String   @default("#64748B")
  buttonColor          String   @default("#2563EB")
  dashboardColor       String   @default("#0F172A")
  themeMode            String   @default("LIGHT")

  updatedAt            DateTime @updatedAt
}

// Temporadas Deportivas (Sprint 5)
model Season {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, FINISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Métodos de Pago Dinámicos (Sprint 5)
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums controlados para Alumnos
enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum DominantFoot {
  DERECHO
  IZQUIERDO
  AMBIDIESTRO
}

enum Position {
  PORTERO
  DEFENSA
  MEDIOCAMPISTA
  DELANTERO
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

// Entidad Categoría de Alumnos
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  color       String    @default("#2563EB")
  minAge      Int       @default(4)
  maxAge      Int       @default(20)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]
}

// Alumnos (Sprint 2 - Unión Jaguera FC)
model Student {
  id                   Int           @id @default(autoincrement())
  photo                String?
  firstName            String
  lastName             String
  document             String        @unique
  birthDate            DateTime
  gender               Gender        @default(MASCULINO)
  categoryId           Int
  category             Category      @relation(fields: [categoryId], references: [id])
  entryDate            DateTime      @default(now())
  position             Position      @default(MEDIOCAMPISTA)
  dominantFoot         DominantFoot  @default(DERECHO)
  jerseyNumber         Int?
  guardianName         String
  guardianRelationship String
  guardianPhone        String
  guardianAddress      String
  eps                  String
  allergies            String?
  medicalNotes         String?
  generalNotes         String?
  customMonthlyFee     Float?
  status               StudentStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  registration         Registration?
  monthlyPayments      MonthlyPayment[]
}

// Modelos del Módulo de Pagos (Sprint 3 - Unión Jaguera FC)

// Inscripciones (Un alumno solo puede tener una inscripción)
model Registration {
  id            Int      @id @default(autoincrement())
  consecutive   String   @unique
  studentId     Int      @unique
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Float    @default(50000.0)
  paymentDate   DateTime @default(now())
  paymentMethod String   @default("EFECTIVO")
  notes         String?
  registeredBy  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Mensualidades (Un alumno no puede pagar dos veces el mismo mes del mismo año)
model MonthlyPayment {
  id            Int      @id @default(autoincrement())
  consecutive   String   @unique
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  amount        Float    @default(50000.0)
  paymentDate   DateTime @default(now())
  paymentMethod String   @default("EFECTIVO")
  notes         String?
  registeredBy  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, month, year])
}

// Consecutivos automáticos para Recibos/Comprobantes de Pago
model Consecutive {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  prefix       String
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

